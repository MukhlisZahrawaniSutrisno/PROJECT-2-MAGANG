# Empty credentials enable an isolated browser-local demo in development only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon key instead of the publishable key (never service_role).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Explicitly opt in only if deploying a public sample containing fictional data.
DEMO_MODE=false
